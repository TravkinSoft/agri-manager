NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Public app URL (Vercel production domain or custom domain)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional aliases used by invite route fallback
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app
INVITE_APP_URL=https://your-app.vercel.app

# Weather Lab (server-only; never expose the real key through NEXT_PUBLIC_*)
UAV_FORECAST_API_KEY=
UAV_FORECAST_API_URL=https://www.uavforecast.com/api/v1/forecast
# Android PWA push notifications. Generate one VAPID pair and keep the private
# key server-only. The public key is returned by the authenticated API.
WEB_PUSH_VAPID_SUBJECT=mailto:support@travkinflow.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
CRON_SECRET=

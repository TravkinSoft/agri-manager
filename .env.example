NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Public app URL (Vercel production domain or custom domain)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional aliases used by invite route fallback
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app
INVITE_APP_URL=https://your-app.vercel.app

# Weather Lab (server-only; never expose the real key through NEXT_PUBLIC_*)
UAV_FORECAST_API_KEY=
UAV_FORECAST_API_URL=https://www.uavforecast.com/api/v1/forecast
# Android PWA push notifications. Generate one VAPID pair and keep the private
# key server-only. The public key is returned by the authenticated API.
WEB_PUSH_VAPID_SUBJECT=mailto:support@travkinflow.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
CRON_SECRET=

# TravkinFlow 2 warehouse ordering. Apply the additive migration before enabling
# the server write gate, then enable the public UI flag in a separate rollout step.
WAREHOUSE_ORDER_WRITE_V1=0
NEXT_PUBLIC_UI_WAREHOUSE_V2=0

# TravkinFlow 2 closed PTC shift history. Keep both gates off until the additive
# history index migration is applied, then enable server before public UI.
DASHBOARD_DATA_V2=0
NEXT_PUBLIC_DASHBOARD_DATA_V2=0

# TravkinFlow 2 field-boundary mutations. Apply both additive field-map
# migrations before enabling the server gate; enable the public admin UI last.
FIELD_BOUNDARY_WRITE_V1=0
NEXT_PUBLIC_FIELD_BOUNDARY_WRITE_V1=0

# TravkinFlow 2 PTC board/shell. Fail closed: only the exact value "1" enables
# the new board layout, sticky lanes, intentional swipe and unified PTC shell.
NEXT_PUBLIC_PTC_BOARD_V2=0

# TravkinFlow 2 canonical field harvest projection. Read-only, but default-off
# until the scoped Product/Preview query plan and load have been verified.
NEXT_PUBLIC_FIELD_HARVEST_LIVE_V2=0

# TravkinFlow 2 private profile photos. Apply the storage/profile migration,
# enable server writes first, then enable the public UI in a separate step.
PROFILE_AVATAR_WRITE_V1=0
NEXT_PUBLIC_PROFILE_AVATAR_V1=0
